# Model strings use litellm format: provider/model-name
#
# Ollama (local)   → ollama_chat/model-name   (chat endpoint, supports tools)
# OpenAI           → gpt-4o  or  openai/gpt-4o
# Anthropic        → anthropic/claude-opus-4-5
# Gemini           → gemini/gemini-2.0-flash
# DeepSeek         → deepseek/deepseek-chat
#
# Embedding models:
# Ollama           → ollama/nomic-embed-text
# OpenAI           → text-embedding-3-small

MODEL=ollama_chat/qwen3-coder:latest
EMBEDDING_MODEL=ollama/nomic-embed-text
PROFILE_MODEL=ollama_chat/gemma3:1b
COMPACT_MODEL=ollama_chat/gemma3:1b
PLANNER_MODEL=ollama_chat/gemma3:1b
EVALUATOR_MODEL=ollama_chat/gemma3:1b

DATABASE_URL=postgresql://myuser:mypassword@localhost:5433/agent_memory

# Ollama server URL — only needed if not on default localhost:11434
# OLLAMA_API_BASE=http://localhost:11434

# ── API keys ────────────────────────────────────────────────────────────────
# Uncomment and fill in the providers you want to use.
# litellm reads these from the environment automatically.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# COHERE_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...
